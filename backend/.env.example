# Copy this file to .env for local development. Never commit .env.

# Where files and data live
STORAGE_BACKEND=local            # local or azure
LOCAL_STORAGE_DIR=./data/uploads
DATABASE_URL=sqlite:///./docmind.db
MAX_UPLOAD_MB=25

# OCR for scans and images
OCR_BACKEND=none                 # none or azure
DOCUMENT_INTELLIGENCE_ENDPOINT=
DOCUMENT_INTELLIGENCE_KEY=

# Embeddings (fake = local stand-in that is NOT semantic)
EMBEDDING_BACKEND=fake           # fake or azure
EMBEDDING_DIMENSIONS=1024
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Search index (memory = local stand-in that forgets everything on restart)
SEARCH_BACKEND=memory            # memory or azure
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=docmind-chunks

# Only needed when STORAGE_BACKEND=azure
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documents
